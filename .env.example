# JAZIDA AI — variaveis de ambiente

# Anthropic SDK (obrigatorio em producao; opcional se DEMO_SAFE=true)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude default (sobrescrita opcional)
# Sonnet 4.5 e o default — rapido e bom em raciocinio
ANTHROPIC_MODEL=claude-sonnet-4-5

# Modo demo seguro: cada agent retorna resposta hardcoded em vez de chamar Claude.
# Use SOMENTE se a API estiver com problema na hora da demo.
DEMO_SAFE=false

# Cidade default do MVP (single-tenant)
DEFAULT_CITY_ID=mariana

# Persistencia opcional do DB in-memory em arquivo JSON.
# Se vazio, DB nao persiste entre restarts.
DB_FILE=./.data/db.json
